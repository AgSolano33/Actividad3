# Iteración 3 — Aritmética mezclada con literales en otras bases,
# strings sueltos, y regresión de iter 1/2.
# Operaciones esperadas:
#   [FF:16] + [1:16]    = 255 + 1 = 256
#   [1010:2] × 2        = 10 × 2  = 20
#   ([10:8] + 1) × 3    = (8+1) × 3 = 27
# Salida esperada:
#   --- aritmética con bases ---
#   256
#   20
#   27
#   fin
print "--- aritmética con bases ---"
print [FF:16] + [1:16]
print [1010:2] × 2
print ([10:8] + 1) × 3
print "fin"
