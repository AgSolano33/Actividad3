# Iteración 6 — TRES while anidados.
# Programa: cuenta los productos i*j*k con 1 ≤ i,j,k ≤ 2.
# Esperado: 8 productos (2*2*2 = 8 iteraciones del cuerpo más interno).
# Imprimimos i, j, k y el producto i × j × k en cada iteración del más interno.
# Filas esperadas (cada bloque de 4 líneas = una iter del más interno):
#   1 1 1 1
#   1 1 2 2
#   1 2 1 2
#   1 2 2 4
#   2 1 1 2
#   2 1 2 4
#   2 2 1 4
#   2 2 2 8
# (Cada número en su propia línea — print emite newline cada uno.)
i <-- 1
while i < 3 do {
  j <-- 1
  while j < 3 do {
    k <-- 1
    while k < 3 do {
      print i
      print j
      print k
      print i × j × k
      k <-- k + 1
    }
    j <-- j + 1
  }
  i <-- i + 1
}
print "FIN"
